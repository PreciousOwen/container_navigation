# Put this on the server as: /etc/daudi/daudi.env
# chmod 600 /etc/daudi/daudi.env

DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=wosac.silicon4forge.org
DJANGO_CSRF_TRUSTED_ORIGINS=https://wosac.silicon4forge.org
DJANGO_SQLITE_PATH=db.sqlite3

# REQUIRED in production:
DJANGO_SECRET_KEY=CHANGE_ME_TO_A_LONG_RANDOM_VALUE

# GPS API authentication. Generate two different long random values.
GPS_DEVICE_API_TOKEN=CHANGE_ME_DEVICE_TOKEN
GPS_MANAGEMENT_API_TOKEN=CHANGE_ME_MANAGEMENT_TOKEN
GPS_PROTOTYPE_DEVICE_ID=GPS-PROTOTYPE-001

# Leave enabled while old firmware posts {"gps_location": "lat,lon"} to
# /sensor_data/. Set to False after moving the device to the authenticated API.
GPS_LEGACY_INGEST_ENABLED=True

# Basic per-IP, per-process request limits for this one-device prototype.
GPS_DEVICE_RATE_LIMIT_PER_MINUTE=120
GPS_MANAGEMENT_RATE_LIMIT_PER_MINUTE=300
